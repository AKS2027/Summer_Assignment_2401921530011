1)TWO SUM PROBLEM:
class Solution {
    public int[] twoSum(int[] nums, int target) {
        
        int sum=0;
        for(int i=0;i<nums.length-1;i++)
        {
            for(int j=i+1;j<nums.length;j++)
            {
            sum=nums[i]+nums[j];
            if(sum==target)
            return new int[]{i,j};
            else
            continue;
        }}
        return new int[]{};
    }
}

2)BEST TIME TO BUY AND SELL STOCK:
class Solution {
    public int maxProfit(int[] prices) {
        int minPrice = Integer.MAX_VALUE;
        int maxProfit = 0;

        for(int price : prices) {
            if(price < minPrice) {
                minPrice = price;
            } else {
                maxProfit = Math.max(maxProfit,
                                     price - minPrice);
            }
        }

        return maxProfit;
    }
}

3) REMOVE DUPLICATES FROM SORTED ARRAY:
class Solution {
    public int removeDuplicates(int[] nums) {

        int n = nums.length;

        if(n == 0)
            return 0;

        int[] ar = new int[n];

        int i = 0;
        int k = 0;

        while(i < n)
        {
            ar[k] = nums[i];
            k++;

            int j = i + 1;

            while(j < n && nums[j] == nums[i])
            {
                j++;
            }

            i = j;
        }

        for(int p = 0; p < k; p++)
        {
            nums[p] = ar[p];
        }

        return k;
    }
}
